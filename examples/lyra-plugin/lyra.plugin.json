              {
                "$ref": "#/$defs/GeoJSONLocation"
              },
              {
                "$ref": "#/$defs/MetZoneCode"
              }
            ],
            "title": "Location"
          }
        },
        "required": [
          "location"
        ],
        "title": "smoke_file_metric_request",
        "type": "object"
      },
      "spatial_inputs": {
        "location": "location"
      }
