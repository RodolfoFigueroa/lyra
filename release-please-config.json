{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "include-component-in-tag": true,
  "separate-pull-requests": false,
  "draft-pull-request": true,
  "bootstrap-sha": "b7b8a8a3ac41e5cdb3c7a9b15ef2c1099fcba73d",
  "group-pull-request-title-pattern": "chore: release v${version}",
  "skip-github-release": true,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "component": "lyra",
      "package-name": "lyra-app",
      "exclude-paths": [
        "docs/**"
      ]
    },
    "packages/lyra_sdk": {
      "component": "lyra-sdk",
      "package-name": "lyra-sdk"
    },
    "packages/lyra_api": {
      "component": "lyra-api",
      "package-name": "lyra-api"
    },
    "packages/lyra_utils": {
      "component": "lyra-utils",
      "package-name": "lyra-utils"
    }
  }
}
